---
// A compact four-crossing three-strand braid. Each crossing has an
// interrupted under-strand; this is a diagram, not intersecting curves.
const steps = [0, 1, 0, 1];
const rows = [24, 56, 88];
const curve = (x: number, a: number, b: number) =>
  `M${x} ${a} C${x + 34} ${a} ${x + 46} ${b} ${x + 80} ${b}`;
---
<svg class="braid-accent" viewBox="0 0 360 112" fill="none" aria-hidden="true" focusable="false">
  {steps.map((pair, i) => {
    const x = 20 + i * 80;
    const top = rows[pair];
    const bottom = rows[pair + 1];
    const untouched = rows[pair === 0 ? 2 : 0];
    return (
      <g>
        <path d={`M${x} ${untouched} H${x + 80}`} />
        <path d={curve(x, bottom, top)} />
        <path class="crossing-gap" d={curve(x, top, bottom)} />
        <path d={curve(x, top, bottom)} />
      </g>
    );
  })}
</svg>
<style>
  .braid-accent { display: block; width: 176px; height: auto; color: var(--green-bright, #91a88f); }
  path { stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; }
  .crossing-gap { stroke: var(--graphite, #191c1a); stroke-width: 6; }
</style>
