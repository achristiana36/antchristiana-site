---
import site from '../data/site.json';
import { sitePath } from '../utils/paths';
---

<footer class="site-footer">
	<div>
		<p class="footer-name">{site.name}</p>
		<p>{site.location}</p>
	</div>
	<div class="footer-links">
		{site.email && <a href={`mailto:${site.email}`}>Email</a>}
		{site.github && <a href={site.github} rel="me">GitHub</a>}
		{site.cv && <a href={sitePath(site.cv)}>CV</a>}
		<a href={sitePath('writing/')}>Writing</a>
	</div>
	<p class="footer-mark">Built as a quiet place for ongoing work. © {new Date().getFullYear()}</p>
</footer>
