---
import site from '../data/site.json';
import { sitePath } from '../utils/paths';
---

<footer class="site-footer">
	<div>
		<p class="footer-name">{site.name}</p>
		<p>{site.location}</p>
	</div>
	<div class="footer-links">
		{site.email && <a href={`mailto:${site.email}`}>Email</a>}
		<a href={sitePath('teaching/')}>Teaching</a>
		<a href={sitePath('research/')}>Research</a>
		{site.github && <a href={site.github} rel="me">GitHub</a>}
		<a href={sitePath('cv/')}>CV &amp; Contact</a>
	</div>
	<p class="footer-mark">Built as a quiet place for ongoing work. © {new Date().getFullYear()}</p>
</footer>
