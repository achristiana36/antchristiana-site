---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import site from '../data/site.json';
import { sitePath } from '../utils/paths';

interface Props {
  heading?: string;
  eyebrow?: string;
  headline?: string;
  role?: string;
  institution?: string;
  graduation?: string;
  photoPosition?: string;
}

const {
  heading = site.name,
  eyebrow = site.eyebrow,
  headline = site.headline,
  role = site.role,
  institution = site.institution,
  graduation = site.expectedGraduation,
  photoPosition = '50% 35%',
} = Astro.props;
---
<section class="home-portrait-hero" aria-labelledby="home-name">
  <div class="home-portrait-hero__copy">
    <p class="home-portrait-hero__eyebrow">{eyebrow}</p>
    <h1 id="home-name">{heading}</h1>
    <p class="home-portrait-hero__headline">{headline}</p>
    <p class="home-portrait-hero__role">
      {role}<br />
      <span>{institution} · {graduation}</span>
    </p>
    <p class="home-portrait-hero__introduction">{site.introduction}</p>
    <div class="home-portrait-hero__actions">
      <a class="home-portrait-hero__primary" href={sitePath('teaching/')}>Explore teaching <span aria-hidden="true">↗</span></a>
      <a class="home-portrait-hero__secondary" href={sitePath('research/')}>View research</a>
      <a class="home-portrait-hero__secondary" href={sitePath(site.cv)} download>Download CV</a>
    </div>
  </div>
  <figure class="home-portrait-hero__figure">
    <div class="home-portrait-hero__photo">
      <Image
        src={headshot}
        alt={`Portrait of ${site.name}`}
        width={780}
        height={975}
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        style={{ objectPosition: photoPosition }}
      />
    </div>
    {site.location && <figcaption>{site.location}</figcaption>}
  </figure>
</section>

<style>
  .home-portrait-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    padding: clamp(2.75rem, 5vw, 4.25rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line, rgba(238,234,224,.14));
  }
  .home-portrait-hero__copy { min-width: 0; }
  .home-portrait-hero__eyebrow { margin: 0 0 1.6rem; color: var(--green-bright, #91a88f); font: 500 .7rem/1.7 var(--sans); letter-spacing: .15em; text-transform: uppercase; }
  .home-portrait-hero h1 { max-width: 10ch; margin: 0 0 1rem; color: var(--paper, #eeeae0); font: 400 clamp(3.5rem, 6.5vw, 6.1rem)/1.02 var(--serif); letter-spacing: -.045em; overflow-wrap: normal; }
  .home-portrait-hero__headline { max-width: 24ch; margin: 0 0 1.5rem; color: var(--paper, #eeeae0); font: 400 clamp(1.55rem, 2.5vw, 2.35rem)/1.2 var(--serif); letter-spacing: -.02em; }
  .home-portrait-hero__role { margin: 0 0 1.5rem; font: 500 .9rem/1.7 var(--sans); color: var(--paper, #eeeae0); }
  .home-portrait-hero__role span { color: var(--paper-soft, #d5d1c7); }
  .home-portrait-hero__introduction { max-width: 49ch; margin: 0 0 2rem; color: var(--paper-soft, #d5d1c7); font: 400 1rem/1.8 var(--sans); }
  .home-portrait-hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem 1.7rem; }
  .home-portrait-hero__actions a { display: inline-flex; min-height: 44px; gap: .9rem; align-items: center; font: 600 .76rem/1.5 var(--sans); letter-spacing: .04em; text-transform: uppercase; }
  .home-portrait-hero__primary { border: 1px solid var(--green-bright, #91a88f); padding: .8rem 1rem; background: var(--green, #69816c); color: #111512; }
  .home-portrait-hero__primary:hover { background: var(--green-bright, #91a88f); }
  .home-portrait-hero__secondary { border-bottom: 1px solid var(--green, #69816c); }
  .home-portrait-hero__secondary:hover { color: var(--green-bright, #91a88f); }
  .home-portrait-hero__figure { margin: 0; width: 100%; max-width: 350px; justify-self: end; }
  .home-portrait-hero__photo { aspect-ratio: 4 / 5; background: var(--graphite-soft, #202421); border: 1px solid var(--line, rgba(238,234,224,.14)); overflow: hidden; }
  .home-portrait-hero__photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .home-portrait-hero figcaption { padding-top: .85rem; color: var(--muted, #9c9f98); font: 400 .67rem/1.5 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  @media (max-width: 760px) {
    .home-portrait-hero { grid-template-columns: minmax(0, 1fr); gap: 2.75rem; padding-top: 3rem; }
    .home-portrait-hero h1 { font-size: clamp(3.25rem, 10vw, 5rem); }
    .home-portrait-hero__figure { justify-self: start; max-width: 360px; }
  }
  @media (max-width: 380px) {
    .home-portrait-hero h1 { font-size: 2.9rem; }
  }
</style>
