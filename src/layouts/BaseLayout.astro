---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KnotBackground from '../components/KnotBackground.astro';
import '../styles/global.css';
import site from '../data/site.json';
import { sitePath } from '../utils/paths';

interface Props {
	title?: string;
	description?: string;
	socialImage?: string | false;
}

const { title, description = site.introduction, socialImage } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Mathematician & educator`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = socialImage === false
	? undefined
	: new URL(sitePath(socialImage ?? 'images/site/og.png'), Astro.site ?? Astro.url);
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	url: new URL(sitePath(), Astro.site ?? Astro.url).href,
	jobTitle: 'PhD Candidate in Mathematics',
	affiliation: {
		'@type': 'CollegeOrUniversity',
		name: site.institution,
	},
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Hamilton College',
	},
	homeLocation: {
		'@type': 'Place',
		name: site.location,
	},
	knowsAbout: [
		'Knot theory',
		'Diagrammatic algebras',
		'Graph theory',
		'Representation theory',
		'Mathematics education',
	],
	award: ['GW Graduate Student Teaching Award (2026)'],
	sameAs: [site.github, site.linkedin].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#191c1a" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
		{socialImageUrl && <meta property="og:image:alt" content={`Anthony Christiana — ${site.headline}`} />}
		<meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
		{socialImageUrl && <meta name="twitter:image:alt" content={`Anthony Christiana — ${site.headline}`} />}
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<div class="page-shell">
			<KnotBackground />
			<Header />
			<main id="content"><slot /></main>
			<Footer />
		</div>
	</body>
</html>
