---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KnotBackground from '../components/KnotBackground.astro';
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = site.introduction } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Mathematician, educator, and writer`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#191c1a" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<div class="page-shell">
			<KnotBackground />
			<Header />
			<main id="content"><slot /></main>
			<Footer />
		</div>
	</body>
</html>

