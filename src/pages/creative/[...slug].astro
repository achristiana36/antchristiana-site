---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mediaPath, sitePath } from '../../utils/paths';

export async function getStaticPaths() {
	const works = await getCollection('creative', ({ data }) => !data.draft);
	return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<BaseLayout title={work.data.title} description={work.data.description}>
	<article class="article creative-detail">
		<a class="back-link" href={sitePath('creative/')}>← All creative work</a>
		<header>
			<p class="eyebrow">{work.data.medium} · {work.data.year}</p>
			<h1>{work.data.title}</h1>
			<p class="article-deck">{work.data.description}</p>
		</header>
		{work.data.image && <img class="creative-hero-image" src={mediaPath(work.data.image)} alt="" />}
		<div class="prose"><Content /></div>
		{work.data.externalUrl && <p><a class="button-link" href={work.data.externalUrl}>Visit the project ↗</a></p>}
	</article>
</BaseLayout>
