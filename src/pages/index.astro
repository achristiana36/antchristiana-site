---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/paths';
import HomeHero from '../components/HomeHero.astro';


const writing = (
	await getCollection('writing', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const research = (
	await getCollection('research')
).sort((a, b) => b.data.year - a.data.year);

const featuredWriting =
	writing.find((item) => item.data.featured) ?? writing[0];

const featuredResearch =
	research.find((item) => item.data.featured) ?? research[0];
---

<BaseLayout>
	<HomeHero />

	<section class="section-block" aria-labelledby="selected-heading">
		<div class="section-heading">
			<p class="kicker">Selected</p>
			<h2 id="selected-heading">Work across disciplines</h2>
		</div>

		<div class="feature-grid">
			{featuredResearch && (
				<a
					class="feature-card feature-card--research"
					href={sitePath('research/')}
				>
					<span class="card-number">01</span>
					<span class="card-type">Research</span>
					<h3>{featuredResearch.data.title}</h3>
					<p>{featuredResearch.data.description}</p>
					<span class="card-arrow" aria-hidden="true">↗</span>
				</a>
			)}

			{featuredWriting && (
				<a
					class="feature-card"
					href={sitePath(`writing/${featuredWriting.id}/`)}
				>
					<span class="card-number">02</span>
					<span class="card-type">Writing & Projects</span>
					<h3>{featuredWriting.data.title}</h3>
					<p>{featuredWriting.data.description}</p>
					<span class="card-arrow" aria-hidden="true">↗</span>
				</a>
			)}
		</div>
	</section>

	{writing.length > 0 && (
		<section
			class="section-block latest"
			aria-labelledby="latest-heading"
		>
			<div class="section-heading section-heading--row">
				<div>
					<p class="kicker">Notebook</p>
					<h2 id="latest-heading">Latest writing & projects</h2>
				</div>

				<a class="text-link" href={sitePath('writing/')}>
					View all
				</a>
			</div>

			<div class="writing-list">
				{writing.slice(0, 3).map((post) => (
					<a href={sitePath(`writing/${post.id}/`)}>
						<time datetime={post.data.date.toISOString()}>
							{post.data.date.toLocaleDateString('en-US', {
								month: 'short',
								day: 'numeric',
								year: 'numeric',
							})}
						</time>

						<h3>{post.data.title}</h3>
						<span aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</section>
	)}
</BaseLayout>