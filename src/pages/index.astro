---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/paths';
import HomeHero from '../components/HomeHero.astro';


const writing = (
	await getCollection('writing', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const research = (
	await getCollection('research')
).sort((a, b) => b.data.year - a.data.year);

const teaching = await getCollection('teaching');

const selectedWork = [
	...research.map((item) => ({
		item,
		section: 'Research',
		href: sitePath(`research/${item.id}/`),
	})),
	...teaching.map((item) => ({
		item,
		section: 'Teaching & Outreach',
		href: sitePath(`teaching/${item.id}/`),
	})),
]
	.filter(({ item }) => item.data.featured)
	.sort(
		(a, b) =>
			(a.item.data.featuredOrder ?? 999) -
			(b.item.data.featuredOrder ?? 999),
	);
---

<BaseLayout>
	<HomeHero />

	<section class="section-block" aria-labelledby="selected-heading">
		<div class="section-heading">
			<p class="kicker">Selected</p>
			<h2 id="selected-heading">Work across disciplines</h2>
		</div>

		<div class="feature-grid">
			{selectedWork.map((work, index) => (
				<a
					class:list={[
						'feature-card',
						work.section === 'Research' && 'feature-card--research',
					]}
					href={work.href}
				>
					<span class="card-number">
						{String(index + 1).padStart(2, '0')}
					</span>
					<span class="card-type">{work.section}</span>
					<h3>{work.item.data.title}</h3>
					<p>{work.item.data.description}</p>
					<span class="card-arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</div>
	</section>

	{writing.length > 0 && (
		<section
			class="section-block latest"
			aria-labelledby="latest-heading"
		>
			<div class="section-heading section-heading--row">
				<div>
					<p class="kicker">Notebook</p>
					<h2 id="latest-heading">Latest writing & projects</h2>
				</div>

				<a class="text-link" href={sitePath('writing/')}>
					View all
				</a>
			</div>

			<div class="writing-list">
				{writing.slice(0, 3).map((post) => (
					<a href={sitePath(`writing/${post.id}/`)}>
						<time datetime={post.data.date.toISOString()}>
							{post.data.date.toLocaleDateString('en-US', {
								month: 'short',
								day: 'numeric',
								year: 'numeric',
							})}
						</time>

						<h3>{post.data.title}</h3>
						<span aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</section>
	)}
</BaseLayout>
