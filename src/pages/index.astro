---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/paths';
import HomeHero from '../components/HomeHero.astro';
import teachingProfile from '../data/teaching.json';


const writing = (
	await getCollection('writing', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const research = (
	await getCollection('research')
).sort((a, b) => b.data.year - a.data.year);

const teaching = await getCollection('teaching');

const selectedWork = [
	...research.map((item) => ({
		item,
		section: 'Research',
		href: sitePath(`research/${item.id}/`),
	})),
	...teaching.map((item) => ({
		item,
		section: 'Teaching & Outreach',
		href: sitePath(`teaching/${item.id}/`),
	})),
]
	.filter(({ item }) => item.data.featured)
	.sort(
		(a, b) =>
			(a.item.data.featuredOrder ?? 999) -
			(b.item.data.featuredOrder ?? 999),
	)
	.slice(0, 3);

const teachingHighlights = [
	{
		label: 'University teaching',
		value: 'Instructor of record in calculus and Mathematics and Politics',
	},
	{
		label: 'Outreach',
		value: `${teachingProfile.outreach.title} · ${teachingProfile.outreach.terms}`,
	},
	{
		label: 'Recognition',
		value: `${teachingProfile.recognition.title} · ${teachingProfile.recognition.year}`,
	},
];
---

<BaseLayout>
	<HomeHero />

	<section class="evidence-strip" aria-label="Teaching record highlights">
		{teachingHighlights.map((highlight) => (
			<div>
				<p>{highlight.label}</p>
				<strong>{highlight.value}</strong>
			</div>
		))}
	</section>

	<section class="section-block" aria-labelledby="selected-heading">
		<div class="section-heading section-heading--row">
			<div>
				<p class="kicker">Selected</p>
				<h2 id="selected-heading">Teaching &amp; research</h2>
			</div>
			<a class="text-link" href={sitePath('teaching/')}>Full teaching record</a>
		</div>

		<div class="feature-grid">
			{selectedWork.map((work, index) => (
				<a
					class:list={[
						'feature-card',
						index === 0 && 'feature-card--accent',
					]}
					href={work.href}
				>
					<span class="card-number">
						{String(index + 1).padStart(2, '0')}
					</span>
					<span class="card-type">{work.section}</span>
					<h3>{work.item.data.title}</h3>
					<p>{work.item.data.description}</p>
					<span class="card-arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</div>
	</section>

	{writing.length > 0 && (
		<section
			class="section-block latest"
			aria-labelledby="latest-heading"
		>
			<div class="section-heading section-heading--row">
				<div>
					<p class="kicker">Notebook</p>
					<h2 id="latest-heading">Latest writing & projects</h2>
				</div>

				<a class="text-link" href={sitePath('writing/')}>
					View all
				</a>
			</div>

			<div class="writing-list">
				{writing.slice(0, 3).map((post) => (
					<a href={sitePath(`writing/${post.id}/`)}>
						<time datetime={post.data.date.toISOString()}>
							{post.data.date.toLocaleDateString('en-US', {
								month: 'short',
								day: 'numeric',
								year: 'numeric',
								timeZone: 'UTC',
							})}
						</time>

						<h3>{post.data.title}</h3>
						<span aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</section>
	)}
</BaseLayout>

<style>
	.evidence-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-bottom: 1px solid var(--line);
	}

	.evidence-strip > div {
		min-width: 0;
		padding: 1.7rem 2rem 1.9rem 0;
	}

	.evidence-strip > div + div {
		padding-left: 2rem;
		border-left: 1px solid var(--line);
	}

	.evidence-strip p {
		margin: 0 0 .45rem;
		color: var(--green-bright);
		font-size: .68rem;
		letter-spacing: .13em;
		text-transform: uppercase;
	}

	.evidence-strip strong {
		display: block;
		max-width: 31ch;
		font: 400 1.06rem/1.45 var(--serif);
	}

	@media (max-width: 760px) {
		.evidence-strip { grid-template-columns: 1fr; }
		.evidence-strip > div { padding: 1.35rem 0; }
		.evidence-strip > div + div {
			padding-left: 0;
			border-top: 1px solid var(--line);
			border-left: 0;
		}
	}
</style>
