---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const items = (await getCollection('research')).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Research" description="Research in knot theory, diagram algebras, and low-dimensional topology.">
	<header class="page-intro">
		<p class="eyebrow">Research</p>
		<h1>Topology, algebra, and the diagrams between them.</h1>
		<p>My work studies how topological information is encoded by diagram algebras, Gram forms, and combinatorial structures, with particular interest in Temperley–Lieb theory and skein modules.</p>
	</header>
	<section class="entry-list" aria-label="Research projects and publications">
		{items.map((item, index) => (
			<article class="entry-row">
				<div class="entry-index">{String(index + 1).padStart(2, '0')}</div>
				<div>
					<p class="entry-meta">{item.data.kind} · {item.data.year}{item.data.venue ? ` · ${item.data.venue}` : ''}</p>
					<h2>{item.data.url ? <a href={item.data.url}>{item.data.title}</a> : item.data.title}</h2>
					<p>{item.data.description}</p>
				</div>
			</article>
		))}
	</section>
</BaseLayout>
