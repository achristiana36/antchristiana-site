---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import teachingProfile from '../data/teaching.json';
import site from '../data/site.json';
import { sitePath } from '../utils/paths';

const items = (await getCollection('teaching')).sort((a, b) => {
	const featuredDifference = Number(b.data.featured) - Number(a.data.featured);
	if (featuredDifference !== 0) return featuredDifference;

	const orderDifference = a.data.order - b.data.order;
	if (orderDifference !== 0) return orderDifference;

	return (b.data.year ?? 0) - (a.data.year ?? 0);
});

const cvHref = sitePath(site.cv);
const teachingStatementHref = sitePath(teachingProfile.documents.teachingStatement.path);
---

<BaseLayout
	title="Teaching"
	description="University teaching record, teaching materials, outreach, and recognition for Anthony Christiana."
>
	<header class="page-intro teaching-intro">
		<p class="eyebrow">Teaching</p>
		<h1>Teaching record</h1>
		<p>Course history, teaching materials, outreach, and recognition.</p>
		<div class="page-actions">
			<a class="button-link" href={cvHref} download="Anthony-Christiana-CV.pdf">Download CV</a>
			<a class="text-link" href={teachingStatementHref} target="_blank" rel="noopener noreferrer">Teaching statement</a>
			<a class="text-link" href={`mailto:${site.email}`}>Email</a>
		</div>
	</header>

	<section class="teaching-summary" aria-label="Teaching highlights">
		<div>
			<p>Instructor of record</p>
			<strong>Five offerings across calculus and Mathematics and Politics</strong>
		</div>
		<div>
			<p>Recognition</p>
			<strong>
				<a href={teachingProfile.recognition.url} target="_blank" rel="noopener noreferrer">
					{teachingProfile.recognition.title} · {teachingProfile.recognition.year} <span aria-hidden="true">↗</span>
				</a>
			</strong>
		</div>
		<div>
			<p>Outreach</p>
			<strong>{teachingProfile.outreach.title} · {teachingProfile.outreach.terms}</strong>
		</div>
	</section>

	<section class="section-block teaching-record" aria-labelledby="record-heading">
		<div class="section-heading">
			<p class="kicker">Experience</p>
			<h2 id="record-heading">University teaching</h2>
		</div>

		<div class="teaching-table-wrap">
			<table>
				<thead>
					<tr>
						<th scope="col">Role</th>
						<th scope="col">Course</th>
						<th scope="col">Institution</th>
						<th scope="col">Term</th>
					</tr>
				</thead>
				<tbody>
					{teachingProfile.experience.map((entry) => (
						<tr>
							<td>{entry.role}</td>
							<th scope="row">{entry.course}</th>
							<td>{entry.institution}</td>
							<td>{entry.terms}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	<section class="section-block teaching-documents" aria-labelledby="documents-heading">
		<div class="section-heading">
			<p class="kicker">Documents</p>
			<h2 id="documents-heading">Application materials</h2>
		</div>

		<div class="document-grid">
			{[teachingProfile.documents.teachingStatement, teachingProfile.documents.teachingEvaluation].map((document) => (
				<a class="document-card" href={sitePath(document.path)} target="_blank" rel="noopener noreferrer">
					<p>{document.detail}</p>
					<h3>{document.title}</h3>
					<span>Open PDF <span aria-hidden="true">↗</span></span>
				</a>
			))}
		</div>

		<div class="document-list-heading">
			<h3>Selected course materials</h3>
			<p>Assignment, assessment, and lecture examples.</p>
		</div>
		<div class="sample-list">
			{teachingProfile.documents.sampleMaterials.map((material) => (
				<a href={sitePath(material.path)} target="_blank" rel="noopener noreferrer">
					<strong>{material.title}</strong>
					<span>{material.detail}</span>
					<span aria-hidden="true">↗</span>
				</a>
			))}
		</div>

		<div class="document-list-heading">
			<h3>Selected syllabi</h3>
			<p>Three courses taught as instructor of record.</p>
		</div>
		<div class="syllabi-list">
			{teachingProfile.documents.syllabi.map((syllabus) => (
				<a href={sitePath(syllabus.path)} target="_blank" rel="noopener noreferrer">
					<span class="syllabus-course">{syllabus.course}</span>
					<strong>{syllabus.title}</strong>
					<span>{syllabus.institution} · {syllabus.term}</span>
					<span aria-hidden="true">↗</span>
				</a>
			))}
		</div>
	</section>

	<section class="section-block" aria-labelledby="materials-heading">
		<div class="section-heading section-heading--row">
			<div>
				<p class="kicker">Portfolio</p>
				<h2 id="materials-heading">Selected teaching &amp; outreach</h2>
			</div>
			<a class="text-link" href={cvHref}>Full academic record</a>
		</div>

		<div class="entry-list teaching-materials">
			{items.map((item, index) => {
				const metadata = [
					item.data.kind,
					item.data.date ?? item.data.year ?? item.data.term,
					item.data.venue ?? item.data.institution,
				]
					.filter(Boolean)
					.join(' · ');

				return (
					<article class="entry-row">
						<div class="entry-index">{String(index + 1).padStart(2, '0')}</div>
						<div>
							{metadata && <p class="entry-meta">{metadata}</p>}
							<h3><a href={sitePath(`teaching/${item.id}/`)}>{item.data.title}</a></h3>
							<p>{item.data.description}</p>
						</div>
					</article>
				);
			})}
		</div>
	</section>

	<section class="record-cta" aria-labelledby="record-cta-heading">
		<div>
			<p class="kicker">Applications</p>
			<h2 id="record-cta-heading">Full academic record</h2>
		</div>
		<div class="record-cta__actions">
			<a class="button-link" href={cvHref} download="Anthony-Christiana-CV.pdf">Download CV</a>
			<a class="text-link" href={sitePath('cv/')}>Contact details</a>
		</div>
	</section>
</BaseLayout>

<style>
	.teaching-intro { padding-bottom: 3.5rem; }
	.page-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 2rem; }
	.page-actions .button-link { margin-top: 0; }

	.teaching-summary {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.teaching-summary > div { min-width: 0; padding: 1.8rem 2rem 2rem 0; }
	.teaching-summary > div + div { padding-left: 2rem; border-left: 1px solid var(--line); }
	.teaching-summary p { margin: 0 0 .5rem; color: var(--green-bright); font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; }
	.teaching-summary strong { display: block; max-width: 31ch; font: 400 1.08rem/1.45 var(--serif); }
	.teaching-summary a:hover { color: var(--green-bright); }

	.teaching-record { padding-bottom: clamp(4rem, 7vw, 6rem); }
	.teaching-table-wrap { overflow-x: auto; border-top: 1px solid var(--line); }
	table { width: 100%; min-width: 780px; border-collapse: collapse; text-align: left; }
	th, td { padding: 1.1rem 1rem 1.1rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
	thead th { color: var(--green-bright); font-size: .68rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
	tbody th { color: var(--paper); font: 400 1rem/1.45 var(--serif); }
	tbody td { color: var(--muted); font-size: .82rem; line-height: 1.55; }
	tbody td:first-child { width: 155px; color: var(--paper-soft); }
	tbody td:last-child { width: 170px; }

	.teaching-documents { padding-top: 0; }
	.document-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.document-card { display: flex; min-height: 190px; flex-direction: column; padding: 1.5rem; border: 1px solid var(--line); background: var(--graphite-soft); }
	.document-card:hover { border-color: var(--green); background: var(--graphite-raised); }
	.document-card p { margin: 0; color: var(--green-bright); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
	.document-card h3 { margin: .8rem 0 1.5rem; font: 400 clamp(1.4rem, 3vw, 2.15rem)/1.12 var(--serif); letter-spacing: -.02em; }
	.document-card > span { margin-top: auto; color: var(--paper-soft); font-size: .78rem; }
	.document-list-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; margin: 3rem 0 1rem; }
	.document-list-heading h3 { margin: 0; font: 400 1.45rem/1.2 var(--serif); }
	.document-list-heading p { margin: 0; color: var(--muted); font-size: .78rem; }
	.sample-list { border-top: 1px solid var(--line); }
	.sample-list a { display: grid; grid-template-columns: minmax(260px, 1fr) minmax(260px, 1fr) 18px; gap: 1.2rem; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--line); }
	.sample-list a:hover strong, .sample-list a:hover > span:last-child { color: var(--green-bright); }
	.sample-list strong { font: 400 1rem/1.4 var(--serif); }
	.sample-list a > span:nth-child(2) { color: var(--muted); font-size: .76rem; }
	.syllabi-list { border-top: 1px solid var(--line); }
	.syllabi-list a { display: grid; grid-template-columns: 100px minmax(180px, .9fr) minmax(260px, 1.2fr) 18px; gap: 1.2rem; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--line); }
	.syllabi-list a:hover strong, .syllabi-list a:hover > span:last-child { color: var(--green-bright); }
	.syllabus-course { color: var(--green-bright); font-size: .68rem; letter-spacing: .1em; }
	.syllabi-list strong { font: 400 1rem/1.4 var(--serif); }
	.syllabi-list a > span:nth-child(3) { color: var(--muted); font-size: .76rem; }

	.teaching-materials { margin-bottom: 0; }
	.teaching-materials h3 { margin: .5rem 0 .65rem; font: 400 clamp(1.65rem, 3vw, 2.6rem)/1.12 var(--serif); letter-spacing: -.02em; }
	.teaching-materials h3 a:hover { color: var(--green-bright); }

	.record-cta { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: 4rem 0 5rem; }
	.record-cta h2 { margin: .7rem 0 0; font: 400 clamp(2rem, 4vw, 3.4rem)/1 var(--serif); letter-spacing: -.03em; }
	.record-cta__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; }
	.record-cta__actions .button-link { margin-top: 0; }

	@media (max-width: 760px) {
		.teaching-summary { grid-template-columns: 1fr; }
		.teaching-summary > div { padding: 1.35rem 0; }
		.teaching-summary > div + div { padding-left: 0; border-top: 1px solid var(--line); border-left: 0; }
		.teaching-table-wrap { overflow: visible; }
		table { min-width: 0; }
		thead { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
		tbody, tbody tr, tbody th, tbody td { display: block; }
		tbody tr { display: grid; gap: .25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
		tbody th, tbody td { width: auto !important; padding: 0; border: 0; }
		tbody td:first-child { color: var(--green-bright); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; }
		tbody th { font-size: 1.12rem; }
		tbody td:last-child { margin-top: .2rem; }
		.document-grid { grid-template-columns: 1fr; }
		.document-list-heading { align-items: flex-start; flex-direction: column; gap: .5rem; }
		.sample-list a { grid-template-columns: minmax(0, 1fr) 16px; gap: .5rem 1rem; }
		.sample-list a > span:nth-child(2) { grid-column: 1; }
		.sample-list a > span:last-child { grid-column: 2; grid-row: 1; }
		.syllabi-list a { grid-template-columns: 80px minmax(0, 1fr) 16px; gap: .5rem 1rem; }
		.syllabi-list a > span:nth-child(3) { grid-column: 2; }
		.syllabi-list a > span:last-child { grid-column: 3; grid-row: 1; }
		.record-cta { align-items: flex-start; flex-direction: column; }
	}
</style>
