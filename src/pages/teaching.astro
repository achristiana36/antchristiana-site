---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/paths';

const items = (await getCollection('teaching')).sort((a, b) => {
	const featuredDifference =
		Number(b.data.featured) - Number(a.data.featured);

	if (featuredDifference !== 0) {
		return featuredDifference;
	}

	const orderDifference = a.data.order - b.data.order;
	if (orderDifference !== 0) {
		return orderDifference;
	}

	return (b.data.year ?? 0) - (a.data.year ?? 0);
});
---

<BaseLayout
	title="Teaching & Outreach"
	description="Teaching, talks, course materials, and mathematical outreach."
>
	<header class="page-intro">
		<p class="eyebrow">Teaching & Outreach</p>
		<h1>Math Education</h1>

		<p>
			I teach mathematics in university courses, private tutoring,
			general-audience lectures, and TRIO Upward Bound. My teaching and
			talks connect mathematics with music, art, programming, history,
			and philosophy.
		</p>
	</header>



	<section class="section-block" aria-labelledby="teaching-heading">
		<div class="section-heading">
			<p class="kicker">Teaching & Outreach</p>
			<h2 id="teaching-heading">Courses, talks, and projects</h2>
		</div>

		<div class="entry-list">
			{items.map((item, index) => {
				const metadata = [
					item.data.kind,
					item.data.date ?? item.data.year ?? item.data.term,
					item.data.venue ?? item.data.institution,
				]
					.filter(Boolean)
					.join(' · ');

				return (
					<article class="entry-row">
						<div class="entry-index">
							{String(index + 1).padStart(2, '0')}
						</div>

						<div>
							{metadata && (
								<p class="entry-meta">{metadata}</p>
							)}

							<h2>
								<a href={sitePath(`teaching/${item.id}/`)}>
									{item.data.title}
								</a>
							</h2>

							<p>{item.data.description}</p>
						</div>
					</article>
				);
			})}
		</div>
	</section>
</BaseLayout>
