---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/paths';

const courses = await getCollection('teaching');

const talks = (
  await getCollection(
    'research',
    ({ data }) => data.section === 'teaching'
  )
).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Teaching" description="Teaching, course materials, and an approach to mathematical explanation.">
	<header class="page-intro">
		<p class="eyebrow">Teaching</p>
		<h1>Math Education</h1>
		<p>I teach math in a variety of settings: university courses, private tutoring, general audience lecturing, & TRIO Upward Bound. I give talks that combine topology, music, art, programming, history, philosophy, and (hopefully) some fun.</p>
	</header>
	<section class="statement statement--compact">
		<p class="kicker">Approach</p>
		<p>My courses emphasize active problem solving, precise communication, and multiple routes into abstraction. This page can hold syllabi, course notes, and teaching materials as the archive grows.</p>
	</section>
	<section class="entry-list" aria-label="Courses">
		{courses.map((course, index) => (
			<article class="entry-row">
				<div class="entry-index">{String(index + 1).padStart(2, '0')}</div>
				<div>
					<p class="entry-meta">{course.data.term}{course.data.institution ? ` · ${course.data.institution}` : ''}</p>
					<h2>{course.data.url ? <a href={course.data.url}>{course.data.title}</a> : course.data.title}</h2>
					<p>{course.data.description}</p>
				</div>
			</article>
		))}
	</section>
	<section class="section-block" aria-labelledby="talks-heading">
  <div class="section-heading">
    <p class="kicker">Talks & outreach</p>
    <h2 id="talks-heading">Mathematics for broader audiences</h2>
  </div>

  <div class="entry-list">
    {talks.map((talk, index) => (
      <article class="entry-row">
        <div class="entry-index">
          {String(index + 1).padStart(2, '0')}
        </div>

        <div>
          <p class="entry-meta">
            {talk.data.kind} · {talk.data.date ?? talk.data.year}
            {talk.data.venue ? ` · ${talk.data.venue}` : ''}
          </p>

          <h2>
            <a href={sitePath(`research/${talk.id}/`)}>
              {talk.data.title}
            </a>
          </h2>

          <p>{talk.data.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
</BaseLayout>
