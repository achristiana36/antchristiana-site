---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/paths';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing & Projects" description="Writing and interdisciplinary projects by Anthony Christiana.">
	<header class="page-intro page-intro--short">
		<p class="eyebrow">Writing & Projects</p>
		<h1>Essays, notes, and selected projects.</h1>
		<p>Writing on mathematics, music, education, digital culture, and interdisciplinary projects.</p>
	</header>
	<section class="writing-index">
		{posts.map((post, index) => (
			<a href={sitePath(`writing/${post.id}/`)}>
				<div class="writing-index-number">{String(index + 1).padStart(2, '0')}</div>
				<div>
					<p class="entry-meta">
						{post.data.type} · <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
					</p>
					<h2>{post.data.title}</h2>
					<p>{post.data.description}</p>
				</div>
				<span aria-hidden="true">↗</span>
			</a>
		))}
	</section>
</BaseLayout>
